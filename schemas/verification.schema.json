{
  "$comment": "THE ONE OPEN RECORD SCHEMA. This index is machine-generated by scripts/fetch_source_metadata.py (owned by agent:orchestrator) from registry payloads whose fields differ per registry: a ClinicalTrials.gov row carries enrollment, phases and why_stopped, a PubMed row carries pmid and pubdate. Closing it would make this schema a mirror of another agent's script, and the fields that matter to rule V6 are required and typed below.",
  "$id": "https://intelligence-blueprint.local/schemas/v0_1_0/verification",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "One line of the source-verification index (contract \u00a77), written by scripts/fetch_source_metadata.py and rebuildable offline from the snapshots under data/raw/. Only `status: verified` passes rule V6. `title_similarity` is a MACHINE-COMPUTED number, which is why it is permitted here and forbidden in a curated record (contract P3, rule V9): it comes from a named implementation, not from an agent's judgement.",
  "examples": [
    {
      "registry": "pubmed",
      "registry_title": null,
      "registry_year": null,
      "retraction_flag": null,
      "snapshot": null,
      "source_id": "SRC:PMID:00000001",
      "status": "not_checked",
      "title_similarity": null
    }
  ],
  "properties": {
    "agent": {
      "description": "Bare agent name that requested the check.",
      "type": [
        "string",
        "null"
      ]
    },
    "checked_at": {
      "description": "ISO-8601 UTC timestamp of the check.",
      "type": [
        "string",
        "null"
      ]
    },
    "claimed_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "claimed_year": {
      "maximum": 2100,
      "minimum": 1800,
      "type": [
        "integer",
        "null"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication_types": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "registry": {
      "description": "Registry consulted (pubmed, ctgov_v2, gwas_catalog, ...).",
      "minLength": 1,
      "type": "string"
    },
    "registry_container": {
      "type": [
        "string",
        "null"
      ]
    },
    "registry_doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "registry_first_author": {
      "type": [
        "string",
        "null"
      ]
    },
    "registry_pmcid": {
      "type": [
        "string",
        "null"
      ]
    },
    "registry_pmid": {
      "type": [
        "string",
        "null"
      ]
    },
    "registry_pubdate": {
      "type": [
        "string",
        "null"
      ]
    },
    "registry_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "registry_year": {
      "maximum": 2100,
      "minimum": 1800,
      "type": [
        "integer",
        "null"
      ]
    },
    "retraction_flag": {
      "description": "null means not determined, which is not 'false'.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "snapshot": {
      "description": "Repo-relative path of the immutable snapshot this came from.",
      "type": [
        "string",
        "null"
      ]
    },
    "source_id": {
      "description": "Source this record verifies.",
      "pattern": "^SRC:(PMID:[0-9]{1,9}|DOI:10\\.[0-9]{4,9}/[-._;()/:a-z0-9<>+\\[\\]]+|NCT:NCT[0-9]{8}|GCST:GCST[0-9]+|DB:[a-z0-9][a-z0-9_]*:[A-Za-z0-9._-]+|DATASET:[a-z0-9][a-z0-9_.-]*)$",
      "type": "string"
    },
    "status": {
      "$comment": "vocabulary: verification_status",
      "description": "Verification outcome; only `verified` passes V6.",
      "enum": [
        "verified",
        "release_verified_by_snapshot",
        "title_mismatch",
        "year_mismatch",
        "not_found",
        "not_checked",
        "retracted",
        "unsupported_registry",
        "snapshot_missing_or_altered"
      ],
      "type": "string"
    },
    "title_similarity": {
      "description": "Machine-computed similarity in [0,1]. Never hand-written.",
      "maximum": 1,
      "minimum": 0,
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "source_id",
    "status"
  ],
  "title": "Source verification record",
  "type": "object"
}
