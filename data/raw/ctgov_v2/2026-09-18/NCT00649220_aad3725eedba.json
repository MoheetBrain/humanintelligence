      "briefTitle": "Memantine and Antipsychotics Use",
      "nctId": "NCT00649220",
      "officialTitle": "Prospective, Single-arm, Multi-centre, Open-label Study to Investigate the Potential to Reduce Concomitant Antipsychotics Use in Patients With Moderate to Severe Dementia of Alzheimer's Type (DAT) Treated With Memantine",
      "orgStudyIdInfo": {
        "id": "MRZ 90001-0716/1"
      },
      "organization": {
        "class": "INDUSTRY",
        "fullName": "Merz Pharmaceuticals GmbH"
