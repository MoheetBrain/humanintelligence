    "descriptionModule": {
      "briefSummary": "The purpose of this study is to assess efficacy and safety of volinanserin in the population of patients complaining of sleep maintenance insomnia. The objective of the substudy is to assess glycemic control in the subgroup of patients with type II diabetes mellitus."
    },
    "designModule": {
      "designInfo": {
