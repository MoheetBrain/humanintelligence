    "outcomesModule": {
      "primaryOutcomes": [
        {
          "measure": "Change in serum creatinine from baseline to Day 14",
          "timeFrame": "Day 14"
        }
      ],
      "secondaryOutcomes": [
        {
          "measure": "To compare four SLV320 doses to placebo on the change in the following variables: Dyspnea (Likert Scale and PDA scale), eGFR (MDRD Formula), Subject Global Clinical Assessment Score, Urine Osmolality, Serum Osmolality",
          "timeFrame": "Up to Day 3 (Dyspnea); Up to Day 4 (Urine Osmolality); Up to Day 60 (eGFR, Subject Global Clinical Assessment Score, Serum Osmolality)"
        },
        {
          "measure": "To compare the effect of four I.V. doses of SLV320 with placebo using the trichotomous endpoint of treatment success, treatment failure, or no change",
          "timeFrame": "Up to Day 14"
        },
        {
          "measure": "To compare the effect of four I.V. doses of SLV320 with placebo on top of diuretic use",
          "timeFrame": "Up to Day 3"
        },
        {
          "measure": "To compare the effect of four I.V. doses of SLV320 with placebo using a composite endpoint of all-cause mortality, cardiovascular hospitalization or hospitalization for worsening renal function, in time to event and frequency",
          "timeFrame": "Up to Day 180"
        },
        {
          "measure": "To determine the pharmacokinetic profile of I.V. SLV320",
          "timeFrame": "Up to Day 3"
        }
      ]
    },
