    "descriptionModule": {
      "briefSummary": "The purpose of this study is to determine the efficacy and safety of IV SLV320 in acute heart failure patients with renal dysfunction.",
      "detailedDescription": "The purpose of this study is to determine the efficacy and safety of IV SLV320 in acute heart failure patients with renal dysfunction."
    },
    "designModule": {
      "designInfo": {
        "allocation": "RANDOMIZED",
        "interventionModel": "PARALLEL",
        "maskingInfo": {
          "masking": "DOUBLE",
          "whoMasked": [
            "PARTICIPANT",
            "INVESTIGATOR"
          ]
        },
        "primaryPurpose": "TREATMENT"
      },
      "enrollmentInfo": {
