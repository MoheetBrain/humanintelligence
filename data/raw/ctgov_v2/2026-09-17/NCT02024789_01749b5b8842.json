    "descriptionModule": {
      "briefSummary": "This multi-center, randomized, double-blind, 3-arm, parallel-group, placebo-controlled study will evaluate the efficacy and safety of RG1662 in adults and adolescents with Down syndrome. Subjects will be randomized to receive RG1662 either at low or high dose or placebo orally twice daily for 26 weeks."
    },
    "designModule": {
      "designInfo": {
        "allocation": "RANDOMIZED",
        "interventionModel": "PARALLEL",
        "maskingInfo": {
          "masking": "DOUBLE",
          "whoMasked": [
            "PARTICIPANT",
            "INVESTIGATOR"
          ]
        },
        "primaryPurpose": "TREATMENT"
      },
      "enrollmentInfo": {
        "count": 173,
        "type": "ACTUAL"
      },
      "phases": [
        "PHASE2"
      ],
      "studyType": "INTERVENTIONAL"
    },
    "eligibilityModule": {
      "eligibilityCriteria": "Inclusion Criteria:\n\n* Individuals aged 12-30 years of age inclusive\n* Clinical diagnosis of Down syndrome (trisomy 21) confirmed by chromosomal analysis (karyotyping)\n* Males, or non-pregnant, non-lactating females. For females of childbearing potential, strict contraceptive prevention is required.\n* Body-mass Index (BMI) 18-42 and 15-30 kg/m2 inclusive for adults and adolescents respectively\n* Ability to complete the Clinical Evaluation of Language Fundamentals (CELF)-preschool 2 word classes task\n* Subjects must have a parent, or other reliable caregiver who agrees to accompany the subject to all clinic visits, provide information about the subject as required by the protocol, and ensure compliance with the medication schedule\n* Study participants must have sufficient language, vision and hearing to participate in study evaluations, as judged clinically by investigator\n\nExclusion Criteria:\n\n* Subjects with a current DSM 5 diagnosis of any primary psychiatric diagnosis (including ASD or MDD)\n* Subjects with a history of infantile spasms, of West syndrome, Lennox-Gastaut syndrome, Early Infantile Epileptic Encephalopathy or any treatment-refractory epilepsy associated with cognitive or developmental regression, of severe head trauma or CNS infections (e.g. meningitis)\n* Subjects with a known or suspected clinical seizure event of any type within 24 months prior to screening\n* Clinically relevant ECG abnormalities at screening or baseline; QTcF above 450 ms; personal or family history (first degree relatives) of congenital long QT syndrome\n* Inadequate renal or hepatic function",
      "healthyVolunteers": false,
      "maximumAge": "30 Years",
      "minimumAge": "12 Years",
      "sex": "ALL",
      "stdAges": [
        "CHILD",
        "ADULT"
      ]
    },
    "identificationModule": {
      "briefTitle": "A Study of RG1662 in Adults and Adolescents With Down Syndrome (CLEMATIS)",
      "nctId": "NCT02024789",
      "officialTitle": "A MULTI-CENTER, RANDOMIZED, DOUBLE-BLIND, PLACEBO-CONTROLLED PHASE 2 STUDY OF THE EFFICACY, SAFETY AND TOLERABILITY OF RG1662 IN ADULTS AND ADOLESCENTS WITH DOWN SYNDROME (CLEMATIS)",
      "orgStudyIdInfo": {
        "id": "BP27832"
      },
